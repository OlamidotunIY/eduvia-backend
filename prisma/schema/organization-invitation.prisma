model OrganizationInvitation {
  id             String   @id @db.Uuid
  orgId          String   @db.Uuid
  inviterUserId  String   @db.Uuid
  inviteeEmail   String
  role           InvitationRole
  subjects       String[]
  tokenHash      String
  status         InvitationStatus
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())

}

enum InvitationRole {
  Teacher
  TeachingAssistant
  parent
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}