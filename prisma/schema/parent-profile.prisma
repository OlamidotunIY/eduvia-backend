// use prisma-8

model ParentProfile {
  id          String   @id @db.Uuid
  userId      String   @unique @db.Uuid
  phoneNumber String?
  timezone    String
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  students StudentProfile[]
}