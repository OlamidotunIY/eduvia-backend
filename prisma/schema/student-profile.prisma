// use prisma-8

model StudentProfile {
  id           String   @id @default(uuid()) @db.Uuid
  parentId     String   @db.Uuid
  dateOfBirth  DateTime
  countryCode  String
  timezone     String
  gradeLevel   String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([parentId])
}
