// use prisma-8

model User {
  id           String @id @db.Uuid
  userType     UserType
  firstName    String
  lastName     String
  email        String        @unique
  username     String? @unique
  image               String?
  emailVerified       Boolean
  twoFactorEnabled    Boolean?
  status       UserStatus
  timezone    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum UserType {
  student
  teacher
  admin
  parent
}

enum UserStatus {
  active
  suspended
}
