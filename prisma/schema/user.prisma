// use prisma-8

model User {
  id           String @id 
  userType     UserType
  firstName    String
  lastName     String
  email        String        @unique
  username     String? @unique
  image               String?
  emailVerified       Boolean
  twoFactorEnabled    Boolean?
  status       UserStatus
  onboardingStatus OnboardingStatus @default(pending)
  activeOrganizationId String?
  timezone    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  @@map("users")
}

enum UserType {
  pending
  student
  teacher
  admin
  parent
}

enum OnboardingStatus {
  pending
  completed
}

enum UserStatus {
  active
  suspended
}
