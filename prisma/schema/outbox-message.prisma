// use prisma-8

model OutboxMessage {
  id            String @id 
  eventId       String @unique 
  type          String
  payload       Json
  aggregateType String
  aggregateId   String 
  correlationId String
  occurredAt    DateTime
  status        OutboxStatus
  attempts      Int          @default(0)
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  @@map("outbox_messages")
}

enum OutboxStatus {
  PENDING
  PROCESSED
}
