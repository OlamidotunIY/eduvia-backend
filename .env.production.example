NODE_ENV=production
PORT=3000
PUBLIC_API_URL=https://api.eduvia.name.ng
CORS_ORIGINS=https://app.eduvia.name.ng,https://app.eduvia.name.ng:5173
DATABASE_URL="mysql://eduvia_admin:eduvia@mysql:3306/eduvia"
REDIS_URL="redis://redis:6379"
BCRYPT_SALT_ROUNDS=10

# Google OAuth (create credentials in Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.eduvia.name.ng/auth/google/callback
FRONTEND_APP_URL=https://app.eduvia.name.ng

# Transactional email (OTP and organization application outcomes)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Eduvia <no-reply@eduvia.name.ng>

# Auth & Observability Secrets
JWT_SECRET=your-32-char-random-jwt-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
PRE_AUTH_TOKEN_TTL=600
OBSERVABLE_API_KEY=your-observable-api-key
OBSERVABLE_SECRET_KEY=your-observable-secret-key

