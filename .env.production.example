NODE_ENV=production
PORT=3000
DATABASE_URL="mysql://eduvia_admin:eduvia@mysql:3306/eduvia"
REDIS_URL="redis://redis:6379"
BCRYPT_SALT_ROUNDS=10

# Auth & Observability Secrets
JWT_SECRET=your-32-char-random-jwt-secret
OBSERVABLE_API_KEY=your-observable-api-key
OBSERVABLE_SECRET_KEY=your-observable-secret-key

# Optional: Cloudflare DNS Automation (used by `make update-dns`)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
