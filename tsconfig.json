{
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": [
      "node",
      "jest"
    ],
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true,
    "rootDir": ".",
    "paths": {
      "@generated/prisma": [
        "./src/generated/prisma"
      ],
      "@generated/prisma/*": [
        "./src/generated/prisma/*"
      ],
      "@modules/auth": [
        "./src/modules/auth/index.ts"
      ],
      "@modules/shared": [
        "./src/modules/shared/index.ts"
      ],
      "@modules/user": [
        "./src/modules/user/index.ts"
      ],
      "@modules/classroom": [
        "./src/modules/classroom/index.ts"
      ],
      "@modules/org": [
        "./src/modules/org/index.ts"
      ],
      "@modules/board": [
        "./src/modules/board/index.ts"
      ]
    }
  }
}