{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": [
      "node",
      "jest"
    ],
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "noCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true,
    "rootDir": ".",
    "paths": {
      "@generated/prisma": [
        "./src/generated/prisma"
      ],
      "@generated/prisma/*": [
        "./src/generated/prisma/*"
      ],
      "@modules/auth": [
        "./src/modules/auth/index"
      ],
      "@modules/shared": [
        "./src/modules/shared/index"
      ],
      "@modules/shared/domain": [
        "./src/modules/shared/domain/index"
      ],
      "@modules/shared/domain/*": [
        "./src/modules/shared/domain/*"
      ],
      "@modules/user": [
        "./src/modules/user/index"
      ],
      "@modules/classroom": [
        "./src/modules/classroom/index"
      ],
      "@modules/org": [
        "./src/modules/org/index"
      ],
      "@modules/board": [
        "./src/modules/board/index"
      ],
      "@modules/assessment": [
        "./src/modules/assessment/index"
      ],
      "@modules/curriculum": [
        "./src/modules/curriculum/index"
      ],
      "@modules/progress": [
        "./src/modules/progress/index"
      ],
      "@modules/notifications": [
        "./src/modules/notifications/index"
      ],
      "@modules/billing": [
        "./src/modules/billing/index"
      ],
      "@modules/platform-admin": [
        "./src/modules/platform-admin/index"
      ],
      "@modules/ai": [
        "./src/modules/ai/index"
      ],
      "@modules/websocket": [
        "./src/modules/websocket/index"
      ]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "prisma7.config.ts"],
  "exclude": ["node_modules", "dist", "apps"]
}
