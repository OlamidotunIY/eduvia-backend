{
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "types": [
      "node",
      "jest"
    ],
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@src/*":              ["src/*"],
      "@modules/*":          ["src/modules/*"],
      "@generated/prisma":   ["src/generated/prisma"],
      "@generated/prisma/*": ["src/generated/prisma/*"],
      "@module/auth":        ["src/modules/auth/index.ts"],
      "@module/user":        ["src/modules/user/index.ts"],
      "@module/shared":      ["src/modules/shared/index.ts"]
    }
  }
}

