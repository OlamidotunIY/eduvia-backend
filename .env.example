NODE_ENV=development
PORT=3000
PUBLIC_API_URL=https://api.eduvia.name.ng
CORS_ORIGINS=https://app.eduvia.name.ng

DATABASE_URL="mysql://eduvia:eduvia@localhost:3306/eduvia"
REDIS_URL="redis://localhost:6379"

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
PRE_AUTH_TOKEN_TTL=600
BCRYPT_SALT_ROUNDS=12

# Google OAuth (create credentials in Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.eduvia.name.ng/auth/google/callback
FRONTEND_APP_URL=https://app.eduvia.name.ng

# Transactional email (OTP and organization application outcomes)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Eduvia <no-reply@eduvia.name.ng>

OBSERVABLE_API_KEY=replace-me
OBSERVABLE_SECRET_KEY=replace-me
